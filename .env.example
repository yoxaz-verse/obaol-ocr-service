SERVICE_MODE=api
PORT=8000
API_KEY=replace-with-a-random-secret-at-least-24-characters
API_KEYS=
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
OCR_LANGUAGE=eng
MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=20
MAX_IMAGE_PIXELS=40000000
MAX_DOCUMENT_PIXELS=200000000

PDF_DPI=180
SYNC_TIMEOUT_SECONDS=120
JOB_TIMEOUT_SECONDS=600
RESULT_TTL_SECONDS=86400
MAX_QUEUED_JOBS=100
MAX_QUEUED_BYTES=536870912
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
WEB_CONCURRENCY=2
TEMP_DIR=/tmp/obaol-ocr
ALLOWED_ORIGINS=
EMBEDDED_TEXT_MIN_WORDS=5
EMBEDDED_TEXT_MIN_CHARS=20
MINIMUM_CONFIDENCE=0.45
DESKEW_MAX_DEGREES=4
OCR_PAGE_SEGMENTATION_MODE=3
PREPROCESSING_MODE=balanced
PAGE_TIMEOUT_SECONDS=45
TRUST_PROXY_HEADERS=false
EXPIRATION_MARKER_TTL_SECONDS=3600
METRICS_ENABLED=true
